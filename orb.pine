//@version=5
// ============================================================================
// Opening Range Break — 3-minute, MES/ES — BACKTEST ONLY
//
// This is your strategy #1 written mechanically, with the exit turned into a setting so
// the Strategy Tester can tell you which exit actually has expectancy. "Hold until
// momentum dies" is not in here on purpose: it cannot be tested, and it is the part of
// your process where greed lives.
//
// !! DO NOT CONNECT THIS TO A BROKER !!
// TradingView can auto-execute a strategy through a linked Tradovate account. Doing that
// on an Apex account is algorithmic execution and forfeits the account and its balance.
// Use this in the Strategy Tester only. Place every order yourself, by hand.
//
// How to use: open MES1! (or ES1!) on a 1-minute chart, add this, set the Exit Rule, and
// read Strategy Tester -> Performance Summary. Then change ONE setting and compare.
// Export "List of Trades" to CSV and the replay harness will run it through the gate.
//
// Validate anything that looks good: pick the winning settings on the older half of the
// history, then check they still work on the recent half WITHOUT changing them. Settings
// tuned on all of the data always look better than they trade.
//
// Note on stop width: the wider the opening range, the wider the stop. On ES the first
// 3-minute range is often more than 12 points, which the risk rules refuse outright; a
// 1- or 2-minute range is usually tradable. Check the skipped-trade count.
//
// Alerts: fires alert() calls carrying the whole ticket - side, contracts, entry, stop,
// target and the dollar risk - plus a "done for the day" message when a lock trips and a
// "flatten now" message at the hard flat time. Create the alert with Condition = this
// script and leave the webhook field EMPTY: these are notifications to your phone, and you
// place every order by hand. Alerts evaluate on bar close, so on a 2-minute chart expect
// the ticket up to two minutes after the break prints.
// ============================================================================
strategy("ORB opening range — backtest only", overlay=true,
     default_qty_type=strategy.fixed, default_qty_value=1,
     initial_capital=100000, currency=currency.USD,
     commission_type=strategy.commission.cash_per_contract, commission_value=0.62,
     calc_on_every_tick=false, process_orders_on_close=true)

// ---------------------------------------------------------------- inputs
grpS = "Session"
openHour   = input.int(9,  "Open hour (exchange time)", minval=0, maxval=23, group=grpS)
openMin    = input.int(30, "Open minute",               minval=0, maxval=59, group=grpS)
orMinutes  = input.int(2,  "Opening range length (minutes)", minval=1, group=grpS,
     tooltip="Run this on a 1-minute chart so the range is exact. On a 2-minute chart the range rounds up to whole bars.")
lastEntry  = input.int(60, "No new entries after N minutes from open", minval=1, group=grpS)
flatMin    = input.int(325,"Flatten everything N minutes after open", minval=1, group=grpS,
     tooltip="325 = 14:55 CT from a 08:30 CT open. Apex forfeits accounts held through the close.")

grpR = "Risk (the gate's rules)"
riskUsd    = input.float(150, "Risk per trade ($)", minval=1, group=grpR,
     tooltip="5% of the EOD drawdown. $150 on a 100K.")
minStopPts = input.float(2,  "Minimum stop (points)", minval=0.25, group=grpR)
maxStopPts = input.float(12, "Maximum stop (points)", minval=0.25, group=grpR,
     tooltip="Trades wider than this are skipped, exactly as the app refuses them.")
dayTarget  = input.float(325, "Lock the day at + $", minval=0, group=grpR)
dayStop    = input.float(450, "Lock the day at - $", minval=0, group=grpR)
maxTrades  = input.int(3,   "Max trades per day", minval=1, group=grpR)
maxConsecL = input.int(2,   "Max consecutive losses per day", minval=1, group=grpR)
useGate    = input.bool(true,"Apply the daily locks", group=grpR,
     tooltip="Turn OFF to see what the same trades do without any discipline. That comparison is the whole point.")

grpX = "Exit rule — change this one at a time"
exitRule = input.string("Fixed 2R", "Exit", group=grpX,
     options=["Opposite end only", "Fixed 2R", "Trail 1R after 1R", "Session end", "Fixed 1.5R"])

// ---------------------------------------------------------------- time helpers
minsFromOpen = (hour * 60 + minute) - (openHour * 60 + openMin)
newDay       = ta.change(time("D")) != 0
inOR         = minsFromOpen >= 0 and minsFromOpen < orMinutes
afterOR      = minsFromOpen >= orMinutes
canEnter     = afterOR and minsFromOpen <= lastEntry
mustBeFlat   = minsFromOpen >= flatMin

var float orHigh = na
var float orLine = na
var float orLow  = na
var int   tradesToday   = 0
var bool  tookBreak     = false
var int   consecLosses  = 0
var float dayStartEquity = na
var bool  dayLocked     = false
var int   lastClosedTrades = 0

if newDay
    orHigh := na
    orLow  := na
    tradesToday  := 0
    tookBreak    := false
    consecLosses := 0
    dayLocked    := false
    dayStartEquity := strategy.equity

if inOR
    orHigh := na(orHigh) ? high : math.max(orHigh, high)
    orLow  := na(orLow)  ? low  : math.min(orLow,  low)

// Track results of closed trades to drive the daily locks.
if strategy.closedtrades > lastClosedTrades
    for i = lastClosedTrades to strategy.closedtrades - 1
        consecLosses := strategy.closedtrades.profit(i) < 0 ? consecLosses + 1 : 0
    lastClosedTrades := strategy.closedtrades

dayPnl = strategy.equity - nz(dayStartEquity, strategy.equity)
if useGate and (dayPnl >= dayTarget or dayPnl <= -dayStop or tradesToday >= maxTrades
     or consecLosses >= maxConsecL)
    dayLocked := true

// ---------------------------------------------------------------- sizing
rangePts = nz(orHigh) - nz(orLow)
tradable = rangePts >= minStopPts and rangePts <= maxStopPts
pointVal = syminfo.pointvalue
qty      = math.max(1, math.round(riskUsd / math.max(rangePts * pointVal, 0.01)))

// ---------------------------------------------------------------- entries
// The FIRST break of the range is the trade. A later re-break is a different setup on a
// stale level, so the day is done once the opening break has been taken.
longBreak  = canEnter and not tookBreak and not na(orHigh) and high >= orHigh
shortBreak = canEnter and not tookBreak and not na(orLow)  and low  <= orLow
flat       = strategy.position_size == 0
allowed    = flat and tradable and (not useGate or not dayLocked) and not mustBeFlat

// The alert text is the order ticket: everything needed to place it by hand, nothing to
// work out in the moment. It is a notification to you — never wire it to a broker.
tick(dir, px, sl, tp, n) =>
    dir + " " + str.tostring(n) + " " + syminfo.ticker
      + "  entry " + str.tostring(px, format.mintick)
      + "  stop " + str.tostring(sl, format.mintick)
      + "  target " + str.tostring(tp, format.mintick)
      + "  |  risk " + str.tostring(math.round(math.abs(px - sl) * pointVal * n)) + " USD"
      + "  reward " + str.tostring(math.round(math.abs(tp - px) * pointVal * n)) + " USD"
      + "  |  stop width " + str.tostring(math.abs(px - sl), format.mintick) + " pts"
      + "  ·  place it yourself, then log it in Trade Gate"

// The first break settles the day even when the rules refuse it: an untradable opening
// break is a no-trade day, not a wait for the next break.
if (longBreak or shortBreak) and flat and barstate.isconfirmed
    tookBreak := true

if allowed and longBreak
    strategy.entry("L", strategy.long, qty=qty)
    tradesToday += 1
    alert(tick("LONG", orHigh, orLow, orHigh + rangePts * 2, qty),
         alert.freq_once_per_bar_close)
else if allowed and shortBreak
    strategy.entry("S", strategy.short, qty=qty)
    tradesToday += 1
    alert(tick("SHORT", orLow, orHigh, orLow - rangePts * 2, qty),
         alert.freq_once_per_bar_close)

// Discipline alerts. The lock message is the one that matters most: it fires at the moment
// you would otherwise talk yourself into another trade.
var bool lockAnnounced = false
if newDay
    lockAnnounced := false
if useGate and dayLocked and not lockAnnounced
    lockAnnounced := true
    string reason = "trade limit"
    if dayPnl >= dayTarget
        reason := "target reached"
    else if dayPnl <= -dayStop
        reason := "daily loss limit"
    else if consecLosses >= maxConsecL
        reason := "two losses in a row"
    alert("DONE FOR THE DAY — " + reason + ". Day P&L "
         + str.tostring(math.round(dayPnl)) + " USD. Close the platform.",
         alert.freq_once_per_bar_close)

if strategy.position_size != 0 and mustBeFlat and not mustBeFlat[1]
    alert("FLATTEN NOW — hard flat time. Holding through the close forfeits the account.",
         alert.freq_once_per_bar_close)

// A skipped setup is worth knowing about too, so a no-trade day feels like a decision.
if canEnter and not tradable and (longBreak or shortBreak) and flat and barstate.isconfirmed
    alert("SKIP — opening range " + str.tostring(rangePts, format.mintick)
         + " pts is outside the " + str.tostring(minStopPts) + "-" + str.tostring(maxStopPts)
         + " point stop rule. No trade today.", alert.freq_once_per_bar_close)

// ---------------------------------------------------------------- exits
var float entryPx = na
var float stopPx  = na
var float riskPts = na
if strategy.position_size != 0 and na(entryPx)
    entryPx := strategy.position_avg_price
    isLong   = strategy.position_size > 0
    stopPx  := isLong ? orLow : orHigh
    riskPts := math.abs(entryPx - stopPx)
if strategy.position_size == 0
    entryPx := na
    stopPx  := na
    riskPts := na

if strategy.position_size != 0 and not na(riskPts)
    isLong = strategy.position_size > 0
    rMult  = exitRule == "Fixed 1.5R" ? 1.5 : 2.0
    tgt    = isLong ? entryPx + riskPts * rMult : entryPx - riskPts * rMult
    id     = isLong ? "L" : "S"

    if exitRule == "Opposite end only"
        strategy.exit(id + "x", id, stop=stopPx)
    else if exitRule == "Fixed 2R" or exitRule == "Fixed 1.5R"
        strategy.exit(id + "x", id, stop=stopPx, limit=tgt)
    else if exitRule == "Trail 1R after 1R"
        // Give back at most 1R from the extreme, and only once 1R in profit.
        strategy.exit(id + "x", id, stop=stopPx,
             trail_points=riskPts / syminfo.mintick,
             trail_offset=riskPts / syminfo.mintick)
    else if exitRule == "Session end"
        strategy.exit(id + "x", id, stop=stopPx)

// Time-based flatten: the session window, then the hard flat.
sessionOver = exitRule == "Session end" and minsFromOpen >= 180   // 11:30 CT
if strategy.position_size != 0 and (mustBeFlat or sessionOver)
    strategy.close_all(comment="flat")

// ---------------------------------------------------------------- plots
plot(inOR or na(orHigh) ? na : orHigh, "OR high", color.new(color.teal, 0), 1, plot.style_linebr)
plot(inOR or na(orLow)  ? na : orLow,  "OR low",  color.new(color.red,  0), 1, plot.style_linebr)
bgcolor(inOR ? color.new(color.blue, 90) : na)
bgcolor(useGate and dayLocked ? color.new(color.orange, 92) : na)
plotchar(not tradable and afterOR and barstate.islast ? true : na, "range too wide", "×",
     location.top, color.orange)
